# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION (Authoritative Persistent Storage - Neon)
# ==============================================================================
# Neon PostgreSQL Connection URI with Connection Pooling:
# e.g. "postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require"
# When set, PostgreSQL is the only authoritative database. Startup fails if it is unreachable.
# SQLite is not a fallback. For local development only, omit DATABASE_URL and set DB_ENGINE=sqlite.
# The Vercel site must set DATABASE_URL, RESEND_API_KEY, EMAIL_FROM, and OTP_HASH_SECRET
# in the project environment. Those values are not stored in this file.
# Property Seeker phone verification also needs one complete SMS provider below.
# Other roles do not require SMS. Unconfigured SMS does not report a successful send.
DATABASE_URL=""
# DB_ENGINE="sqlite"
# Optional pool overrides:
PG_POOL_MAX="10"
# Set to 'disable' only for local non-SSL postgres testing; omit for Neon SSL
# PGSSLMODE="require"

# MongoDB is not used. Do not configure a second database.

# ==============================================================================
# REGISTRATION EMAIL OTP (Resend only — verified domain propertystudio.org)
# ==============================================================================
# Server-side only. Never commit a real key. Registration does not fall back to
# onboarding@resend.dev or another provider. A failed send discards the code.
RESEND_API_KEY=""
EMAIL_FROM="Property Studio <otp@propertystudio.org>"
# Legacy alias used only when EMAIL_FROM is unset. Must still be @propertystudio.org.
RESEND_FROM="Property Studio <otp@propertystudio.org>"
# Pepper for OTP hashes. Required before any email code is issued.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=""
# Leave unset so Neon TLS certificates are verified. Set to false only if the host
# CA store cannot validate the Neon certificate.
# PGSSL_REJECT_UNAUTHORIZED="true"

# The providers below are not used for registration or password-reset email.
# Option 2: Brevo / Sendinblue (https://brevo.com - 300 free emails/day)
BREVO_API_KEY="xkeysib-your_api_key_here"
BREVO_SENDER_EMAIL="otp@propertystudio.org"

# Option 3: SendGrid (https://sendgrid.com)
SENDGRID_API_KEY="SG.your_api_key_here"
SENDGRID_FROM="Property Studio <otp@propertystudio.org>"

# Option 4: Mailjet (https://mailjet.com - 200 free emails/day)
MAILJET_API_KEY="your_mailjet_api_key"
MAILJET_SECRET_KEY="your_mailjet_secret_key"
MAILJET_FROM="Property Studio <otp@propertystudio.org>"

# Option 5: Postmark (https://postmarkapp.com)
POSTMARK_SERVER_TOKEN="your_postmark_token"
POSTMARK_FROM="Property Studio <otp@propertystudio.org>"

# Option 6: Direct SMTP (Gmail App Password, Outlook, AWS SES, Hostinger, Zoho)
# Example for Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Property Studio <your-email@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Property Studio <otp@propertystudio.org>"

# ==============================================================================
# SMS OTP — Fast2SMS only (https://www.fast2sms.com). Property Seeker registration
# requires a real delivery. A missing key or template id fails closed.
# ==============================================================================
# 1. Create a Fast2SMS account and complete DLT registration for the business entity.
# 2. Get a 3-6 letter sender ID (header) approved on the DLT portal, then add that
#    header in the Fast2SMS DLT manager. The application does not send or invent a sender ID.
# 3. Approve an OTP content template on DLT and link it to that sender. Create the
#    matching OTP template in Fast2SMS (Smart OTP / OTP Template List) and copy its OTP ID.
# 4. Copy the Dev API key. Put the key and OTP ID in the server environment only.
# 5. If the approved template has {#var#} placeholders, set FAST2SMS_OTP_VARIABLES to the
#    pipe-separated values in template order. Use {otp} wherever the verification code
#    must appear, for example: {otp}
#    Leave it empty when the OTP template inserts the code itself and has no extra variables.
# Other SMS gateways are not used for registration.
FAST2SMS_API_KEY=""
FAST2SMS_OTP_ID=""
FAST2SMS_OTP_VARIABLES=""

# ==============================================================================
# INITIAL PRODUCTION CREDENTIAL BOOTSTRAP (DEVELOPER & SUPER_ADMIN)
# ==============================================================================
# Set these only in the server environment. Do not commit the values.
# npm run bootstrap creates a missing account and does not reset an existing password or role.
# It does not run on server start. For Neon, run npm run db:init first, then bootstrap.
# Intended emails: developer@propertystudio.org (DEVELOPER), admin@propertystudio.org (SUPER_ADMIN).
BOOTSTRAP_DEVELOPER_EMAIL=""
BOOTSTRAP_DEVELOPER_PASSWORD=""
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""

# Independent root recovery key for POST /api/auth/recover-developer. Leave empty to disable recovery.
DEVELOPER_RECOVERY_KEY=""

# Payments. Leave empty to report NOT_CONFIGURED. A missing provider never marks a payment successful.
PAYMENT_PROVIDER=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_API_KEY=""


