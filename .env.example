# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MONGODB DATABASE CONFIGURATION (Stores all user registrations and profiles)
# ==============================================================================
# MongoDB Atlas Connection URI or Self-Hosted MongoDB:
# e.g. "mongodb+srv://<username>:<password>@cluster0.mongodb.net/property_studio?retryWrites=true&w=majority"
MONGODB_URI=""
MONGODB_DB_NAME="property_studio"

# ==============================================================================
# REAL-TIME EMAIL OTP DISPATCH GATEWAYS (Configure any one of the following)
# ==============================================================================
# Option 1: Resend (https://resend.com - Recommended for instant deliverability)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM="Property Studio <otp@propertystudio.org>"

# Option 2: Brevo / Sendinblue (https://brevo.com - 300 free emails/day)
BREVO_API_KEY="xkeysib-your_api_key_here"
BREVO_SENDER_EMAIL="otp@propertystudio.org"

# Option 3: SendGrid (https://sendgrid.com)
SENDGRID_API_KEY="SG.your_api_key_here"
SENDGRID_FROM="Property Studio <otp@propertystudio.org>"

# Option 4: Mailjet (https://mailjet.com - 200 free emails/day)
MAILJET_API_KEY="your_mailjet_api_key"
MAILJET_SECRET_KEY="your_mailjet_secret_key"
MAILJET_FROM="Property Studio <otp@propertystudio.org>"

# Option 5: Postmark (https://postmarkapp.com)
POSTMARK_SERVER_TOKEN="your_postmark_token"
POSTMARK_FROM="Property Studio <otp@propertystudio.org>"

# Option 6: Direct SMTP (Gmail App Password, Outlook, AWS SES, Hostinger, Zoho)
# Example for Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Property Studio <your-email@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Property Studio <otp@propertystudio.org>"

# ==============================================================================
# REAL-TIME SMS OTP DISPATCH GATEWAYS (Configure any one for mobile carrier delivery)
# ==============================================================================
# Option 1: Twilio (Global carrier delivery - https://twilio.com)
TWILIO_ACCOUNT_SID="AC_your_account_sid"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_SENDER_ID="Property Studio"

# Option 2: Fast2SMS (Direct Indian Telecom Delivery for Airtel, Jio, Vi, BSNL - https://fast2sms.com)
FAST2SMS_API_KEY="your_fast2sms_api_key"
FAST2SMS_SENDER_ID="PROPST"

# Option 3: MSG91 (DLT & Global OTP route - https://msg91.com)
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_otp_template_id"
MSG91_SENDER_ID="PROPST"

# Option 4: 2Factor (India OTP SMS Gateway - https://2factor.in)
TWOFACTOR_API_KEY="your_2factor_api_key"

# Option 5: Textlocal (https://textlocal.in)
TEXTLOCAL_API_KEY="your_textlocal_api_key"
TEXTLOCAL_SENDER="PROPST"

# ==============================================================================
# INITIAL PRODUCTION CREDENTIAL BOOTSTRAP (DEVELOPER & SUPER_ADMIN)
# ==============================================================================
# DEVELOPER: Platform Owner role (protected from Super Admin revocation)
BOOTSTRAP_DEVELOPER_EMAIL="developer@propertystudio.org"
BOOTSTRAP_DEVELOPER_PASSWORD="YourStrongDeveloperPassword123!"

# SUPER_ADMIN: Platform Administrator role
BOOTSTRAP_SUPER_ADMIN_EMAIL="admin@propertystudio.org"
BOOTSTRAP_SUPER_ADMIN_PASSWORD="YourStrongSuperAdminPassword123!"

# Independent Root Recovery Key (for /api/auth/recover-developer emergency reset)
DEVELOPER_RECOVERY_KEY="ps_dev_master_recovery_2026"


